{
  "name": "yuki-desktop",
  "version": "1.0.0-beta.1",
  "private": true,
  "description": "與持續存在的 Yuki 對話、共事與接續工作",
  "author": "Institute of Agent Life",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "out/main/app.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint src tests build-tools *.ts *.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build-tools/test.mjs",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "check:package": "node build-tools/check-package.mjs",
    "postinstall": "electron-builder install-app-deps",
    "check:contract": "node build-tools/check-contract.mjs",
    "generate:contract": "openapi-typescript contracts/client-api.openapi.json -o src/shared/contract.gen.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.4",
    "better-sqlite3": "13.0.3",
    "lucide-react": "1.59.0",
    "markdown-it": "15.0.3",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "electron": "42.11.15",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "9.39.5",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
