{
  "name": "yuki-desktop",
  "version": "1.0.0-beta.8",
  "private": true,
  "description": "與持續存在的 Yuki 對話、共事與接續工作",
  "desktopName": "yuki.desktop",
  "author": "Institute of Agent Life",
  "homepage": "https://github.com/Institute-of-Agent-Life/Yuki-Desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Institute-of-Agent-Life/Yuki-Desktop.git"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "out/main/app.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run icons && electron-vite dev",
    "build": "npm run icons && npm run typecheck && electron-vite build",
    "icons": "node build-tools/icons.mjs",
    "preview": "electron-vite preview",
    "lint": "eslint src tests build-tools *.ts *.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build-tools/test.mjs",
    "test:release": "node --test --experimental-test-isolation=none tests/release/packages.test.mjs tests/release/connector-signing.test.mjs",
    "test:signing": "node --test --experimental-test-isolation=none tests/release/signing.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && electron-builder --config build-tools/builder-config.mjs --publish never",
    "package:dir": "npm run build && electron-builder --config build-tools/builder-config.mjs --dir --publish never",
    "check:package": "node build-tools/check-package.mjs",
    "postinstall": "patch-package --error-on-fail && electron-builder install-app-deps",
    "check:contract": "node build-tools/check-contract.mjs",
    "generate:contract": "node build-tools/generate-contract.mjs",
    "upgrade:soul": "node build-tools/run-soul-conversion.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@novnc/novnc": "1.7.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@tanstack/react-query": "5.104.4",
    "better-sqlite3": "13.0.3",
    "builder-util-runtime": "9.7.0",
    "diff": "9.0.0",
    "electron-updater": "6.8.9",
    "katex": "0.19.1",
    "lucide-react": "1.59.0",
    "markdown-it": "15.0.3",
    "mermaid": "12.2.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.5",
    "shiki": "4.5.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "electron": "42.11.15",
    "electron-builder": "26.15.6",
    "electron-vite": "6.0.0",
    "eslint": "9.39.5",
    "js-yaml": "4.3.2",
    "openapi-typescript": "7.13.0",
    "patch-package": "8.0.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
